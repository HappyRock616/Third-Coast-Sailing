<?xml version="1.0" encoding="utf-8"?>
<!-- No backup of user data (Android 11 and older): allowBackup is false in the manifest, and everything is excluded
     here as well. Tracks, anchor and MOB positions, routes and logs stay on the phone. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
